--- !u!114 &4879005895451398713
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 9031658654919893134}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 01d578b8429c3d84c8980bd66ecf1ce9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GladiatorBark
  barkText: {fileID: 3816435291312660503}
  bubbleBackground: {fileID: 1965286789555336353}
  minTimeBetweenBarks: 10
  maxTimeBetweenBarks: 25
  displayDuration: 3.5
  typeDelay: 0.04
  idleBarks:
  - "Ate\u015Fin s\u0131cakl\u0131\u011F\u0131 da olmasa donaca\u011F\u0131z."
  - "K\u0131l\u0131c\u0131m paslanmadan bir sava\u015F \xE7\u0131ksa bari."
  - "Acaba memlekette durumlar nas\u0131ld\u0131r?"
  - "Beyimiz sa\u011F olsun, oca\u011F\u0131m\u0131z t\xFCt\xFCyor."
  trainingBarks:
  - "Daha h\u0131zl\u0131! Daha g\xFC\xE7l\xFC!"
  - Kolumu hissetmiyorum...
  - "Kan terlemezsek sava\u015Fta can veririz!"
  workingBarks:
  - "S\u0131rt\u0131m koptu \u015Fu odunlar\u0131 yarmaktan..."
  - "Asker miyiz \u0131rgat m\u0131y\u0131z belli de\u011Fil."
  - "Al\u0131n teri d\xF6kmeden alt\u0131n kazan\u0131lmaz."
  lowMoraleBarks:
  - "Bu gidi\u015Fle sonumuz pek hay\u0131rl\u0131 de\u011Fil..."
  - Bu kadar emek niye!
  - "\xC7oluk \xE7ocuk a\xE7!"
  - "A\u015F ve ate\u015F yokken maa\u015F\u0131 neyleyim!"
  winterBarks:
  - "K\u0131\u015F kap\u0131ya dayand\u0131, erzaklar yetecek mi acaba?"
  - "Ayaz kemiklerime i\u015Fliyor..."
  - "Umar\u0131m k\u0131\u015F gelmeden yuvam\u0131za d\xF6neriz."
